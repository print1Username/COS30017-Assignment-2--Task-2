<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/bookingInformationLayout"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="@android:color/white">

	<!-- Hotel Image -->
	<ImageView
		android:id="@+id/roomImage"
		android:layout_width="match_parent"
		android:layout_height="200dp"
		android:scaleType="centerCrop"
		android:contentDescription="Hotel image"
		android:src="@drawable/room1" />

	<!-- Booking Information Title -->
	<TextView
		android:id="@+id/bookingInformationTitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#6AC5FD"
		android:paddingStart="16dp"
		android:paddingTop="12dp"
		android:paddingEnd="16dp"
		android:paddingBottom="12dp"
		android:text="Your Booking Information"
		android:textColor="@android:color/white"
		android:textSize="20sp"
		android:textStyle="bold" />

	<!-- Booking Details -->
	<LinearLayout
		android:id="@+id/bookingDetailsContainer"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingTop="16dp"
		android:paddingEnd="16dp"
		android:paddingBottom="20dp">

		<!-- Room Type -->
		<TextView
			android:id="@+id/roomTypeText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:text="Room Type: -"
			android:textColor="@android:color/black"
			android:textSize="16sp" />

		<!-- Check-In Date -->
		<TextView
			android:id="@+id/checkInDateText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:text="Check-In Date: -"
			android:textColor="@android:color/black"
			android:textSize="16sp" />

		<!-- Check-Out Date -->
		<TextView
			android:id="@+id/checkOutDateText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="10dp"
			android:text="Check-Out Date: -"
			android:textColor="@android:color/black"
			android:textSize="16sp" />

		<!-- Total Amount -->
		<TextView
			android:id="@+id/totalAmountText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Total Amount: RM 0.00"
			android:textColor="@android:color/black"
			android:textSize="16sp"
			android:textStyle="bold" />

	</LinearLayout>

</LinearLayout>